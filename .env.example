# Copy this file to .env and adjust as needed.
# docker-compose reads root-level values like JWT_SECRET; the api/ and web/
# directories also have their own .env for running services outside Docker.

# --- Shared / docker-compose ---
JWT_SECRET=replace-with-a-long-random-string

# --- api/.env ---
PORT=4000
CORS_ORIGIN=http://localhost:3000
MONGO_URI=mongodb://localhost:27017/pulseboard
JWT_SECRET=replace-with-a-long-random-string

# --- web/.env.local ---
NEXT_PUBLIC_API_URL=http://localhost:4000
